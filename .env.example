# Copy to .env. Never commit a real key.
# Any OpenAI-compatible endpoint works; mock mode needs none of this.
FOUNDRY_BASE_URL=https://api.example.com/v1
FOUNDRY_API_KEY=__CHANGE_ME__
FOUNDRY_MODEL=example-model

# Budget per run (hard stops, see src/foundry/budget.py)
FOUNDRY_MAX_TOKENS=20000
FOUNDRY_MAX_COST_HUF=120
FOUNDRY_MAX_STEPS=6

# Prices used for the cost estimate (HUF per 1k tokens)
FOUNDRY_PRICE_IN=2.0
FOUNDRY_PRICE_OUT=6.0
